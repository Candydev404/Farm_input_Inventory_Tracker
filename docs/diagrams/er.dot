digraph E { rankdir=LR; graph [fontname="Helvetica", dpi=170, pad=0.25, nodesep=0.4, ranksep=1.0]; node [fontname="Helvetica", fontsize=10]; edge [fontname="Helvetica", fontsize=9, color="#4b6b5a", arrowhead=crow, arrowtail=tee, dir=both];
  users [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1f6f43"><TR><TD BGCOLOR="#1f6f43"><FONT COLOR="white"><B>users</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id PK</TD></TR><TR><TD ALIGN="LEFT" PORT="username">username UNIQUE</TD></TR><TR><TD ALIGN="LEFT" PORT="full_name">full_name</TD></TR><TR><TD ALIGN="LEFT" PORT="email">email</TD></TR><TR><TD ALIGN="LEFT" PORT="password_hash">password_hash</TD></TR><TR><TD ALIGN="LEFT" PORT="role">role (admin|storekeeper)</TD></TR><TR><TD ALIGN="LEFT" PORT="is_active">is_active</TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD></TR><TR><TD ALIGN="LEFT" PORT="last_login">last_login</TD></TR></TABLE>>];
  categories [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1f6f43"><TR><TD BGCOLOR="#1f6f43"><FONT COLOR="white"><B>categories</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id PK</TD></TR><TR><TD ALIGN="LEFT" PORT="name">name UNIQUE</TD></TR></TABLE>>];
  suppliers [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1f6f43"><TR><TD BGCOLOR="#1f6f43"><FONT COLOR="white"><B>suppliers</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id PK</TD></TR><TR><TD ALIGN="LEFT" PORT="name">name UNIQUE</TD></TR><TR><TD ALIGN="LEFT" PORT="phone">phone</TD></TR><TR><TD ALIGN="LEFT" PORT="address">address</TD></TR></TABLE>>];
  inventory_items [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1f6f43"><TR><TD BGCOLOR="#1f6f43"><FONT COLOR="white"><B>inventory_items</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id PK</TD></TR><TR><TD ALIGN="LEFT" PORT="item_code">item_code UNIQUE</TD></TR><TR><TD ALIGN="LEFT" PORT="name">name</TD></TR><TR><TD ALIGN="LEFT" PORT="category_id">category_id FK</TD></TR><TR><TD ALIGN="LEFT" PORT="description">description</TD></TR><TR><TD ALIGN="LEFT" PORT="quantity">quantity (CHECK &gt;= 0)</TD></TR><TR><TD ALIGN="LEFT" PORT="unit">unit</TD></TR><TR><TD ALIGN="LEFT" PORT="min_threshold">min_threshold</TD></TR><TR><TD ALIGN="LEFT" PORT="unit_price">unit_price</TD></TR><TR><TD ALIGN="LEFT" PORT="supplier_id">supplier_id FK</TD></TR><TR><TD ALIGN="LEFT" PORT="is_returnable">is_returnable</TD></TR><TR><TD ALIGN="LEFT" PORT="is_sample">is_sample</TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at">updated_at</TD></TR></TABLE>>];
  stock_transactions [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1f6f43"><TR><TD BGCOLOR="#1f6f43"><FONT COLOR="white"><B>stock_transactions</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id PK</TD></TR><TR><TD ALIGN="LEFT" PORT="reference">reference UNIQUE</TD></TR><TR><TD ALIGN="LEFT" PORT="item_id">item_id FK</TD></TR><TR><TD ALIGN="LEFT" PORT="txn_type">txn_type (IN|OUT|LOAN|RETURN)</TD></TR><TR><TD ALIGN="LEFT" PORT="quantity">quantity (CHECK &gt; 0)</TD></TR><TR><TD ALIGN="LEFT" PORT="balance_after">balance_after</TD></TR><TR><TD ALIGN="LEFT" PORT="unit_price">unit_price</TD></TR><TR><TD ALIGN="LEFT" PORT="txn_date">txn_date</TD></TR><TR><TD ALIGN="LEFT" PORT="responsible">responsible</TD></TR><TR><TD ALIGN="LEFT" PORT="counterparty">counterparty</TD></TR><TR><TD ALIGN="LEFT" PORT="notes">notes</TD></TR><TR><TD ALIGN="LEFT" PORT="created_by">created_by FK</TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD></TR><TR><TD ALIGN="LEFT" PORT="is_sample">is_sample</TD></TR></TABLE>>];
  system_notifications [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1f6f43"><TR><TD BGCOLOR="#1f6f43"><FONT COLOR="white"><B>system_notifications</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id PK</TD></TR><TR><TD ALIGN="LEFT" PORT="item_id">item_id FK</TD></TR><TR><TD ALIGN="LEFT" PORT="kind">kind (LOW|OUT|INFO)</TD></TR><TR><TD ALIGN="LEFT" PORT="message">message</TD></TR><TR><TD ALIGN="LEFT" PORT="is_read">is_read</TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD></TR></TABLE>>];
  audit_logs [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1f6f43"><TR><TD BGCOLOR="#1f6f43"><FONT COLOR="white"><B>audit_logs</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id PK</TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">user_id FK</TD></TR><TR><TD ALIGN="LEFT" PORT="action">action</TD></TR><TR><TD ALIGN="LEFT" PORT="detail">detail</TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD></TR></TABLE>>];
  settings [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1f6f43"><TR><TD BGCOLOR="#1f6f43"><FONT COLOR="white"><B>settings</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="key">key PK</TD></TR><TR><TD ALIGN="LEFT" PORT="value">value</TD></TR></TABLE>>];
  categories -> inventory_items [label="1 : N"];
  suppliers -> inventory_items [label="1 : N"];
  inventory_items -> stock_transactions [label="1 : N"];
  inventory_items -> system_notifications [label="1 : N"];
  users -> stock_transactions [label="1 : N (created_by)"];
  users -> audit_logs [label="1 : N"];
}
